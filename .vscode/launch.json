{
    // IntelliSense を使用して利用可能な属性を学べます。
    // 既存の属性の説明をホバーして表示します。
    // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python デバッガー: 現在のファイル",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python デバッガー: 引数を含む現在のファイル",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            // 識別名（任意の名前を指定可）
            "name": "Debug proc_ransac_c.elf",

            "type": "cppdbg",
            "request": "launch",

            // 実行するプログラム(proc_ransac_c.elf)を設定
            //  実行時引数をargsに追加
            //  stopAtEntry==true: main関数先頭に自動的にブレークポイントを張る
            "program": "${workspaceFolder}/build/proc_ransac_c/proc_ransac_c.elf",
            "args": ["${workspaceFolder}/data/test_img.jpg"],
            "stopAtEntry": true,

            // 実行ディレクトリをワークスペースディレクトリに設定
            "cwd": "${workspaceFolder}",
            "environment": [],

            // gdbを設定
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "externalConsole": false
        }
    ]
}